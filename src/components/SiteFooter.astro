---
import CallButton from './CallButton.astro';
import { shop } from '@/data/shop';
import { services } from '@/data/services';
import { formatHourLines } from '@/lib/formatHours';

const hourLines = formatHourLines(shop.hours);
const year = new Date().getFullYear();
---
<footer class="bg-[var(--color-char)] text-[var(--color-paper)] border-t border-[var(--color-bone)]/10">
  <div class="container-default grid gap-12 py-16 md:grid-cols-3">
    <div>
      <h3 class="eyebrow mb-4">Visit</h3>
      <address class="not-italic leading-relaxed">
        {shop.name}<br/>
        {shop.address.line1}<br/>
        {shop.address.city}, {shop.address.state} {shop.address.zip}
      </address>
      <p class="mt-4">{hourLines.map((l, i) => <>{i > 0 && <br/>}{l}</>)}</p>
      <div class="mt-6"><CallButton variant="primary" /></div>
    </div>
    <div>
      <h3 class="eyebrow mb-4">Services</h3>
      <ul class="space-y-2">
        {services.map(s => <li><a href={`/services#${s.id}`} class="hover:text-[var(--color-gold)] transition-colors">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <h3 class="eyebrow mb-4">Trusted by</h3>
      <ul class="flex flex-wrap gap-2">
        {shop.certifications.map(c => <li class="px-3 py-1 border border-[var(--color-bone)]/25 rounded-full text-sm">{c}</li>)}
      </ul>
    </div>
  </div>
  <div class="border-t border-[var(--color-bone)]/10 py-6 text-center text-sm text-[var(--color-bone)]/70">
    © {year} {shop.name} · {shop.address.city}, {shop.address.state}
  </div>
</footer>
