---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionLight from '@/components/SectionLight.astro';
import Eyebrow from '@/components/Eyebrow.astro';
import { getImage } from 'astro:assets';
import { builds } from '@/data/builds';
import { photoById } from '@/data/photos';
import { IMAGE_QUALITY, GALLERY_THUMB_WIDTH, GALLERY_FULL_WIDTH } from '@/lib/imageDefaults';
import BuildGallery from '@/components/builds/BuildGallery';
import TodoBlock from '@/components/TodoBlock.astro';

// Thumbnails and lightbox images are generated here rather than handed to the
// React island as raw originals — the gallery previously rendered the
// full-resolution files, which came to ~28MB for this one page.
const items = await Promise.all(
  builds.flatMap(b =>
    b.photoIds.map((pid, idx) => ({ b, pid, idx }))
  ).map(async ({ b, pid, idx }) => {
    const p = photoById(pid)!;
    const [thumb, full] = await Promise.all([
      getImage({ src: p.image, width: GALLERY_THUMB_WIDTH, quality: IMAGE_QUALITY }),
      getImage({ src: p.image, width: GALLERY_FULL_WIDTH, quality: IMAGE_QUALITY }),
    ]);
    return {
      id: `${b.id}-${idx}`,
      // Only the first photo of each build carries the build's own id, so
      // deep links like /builds#lexus-gx-long-travel land on it.
      anchorId: idx === 0 ? b.id : undefined,
      title: b.title,
      vehicle: b.vehicle,
      summary: b.summary,
      category: b.category,
      photoSrc: thumb.src,
      photoFullSrc: full.src,
      photoAlt: p.alt,
    };
  }),
);
---
<BaseLayout title="4×4 Builds Gallery" description="Real lift kits, suspension work, and full 4×4 builds out of Pappytackle in Lynden, WA.">
  <SectionLight tone="paper">
    <Eyebrow class="!text-[var(--color-ember)]">The showcase</Eyebrow>
    <h1 class="mt-2 text-5xl md:text-6xl">4×4 Builds & Customization</h1>
    <p class="mt-4 max-w-2xl text-lg">Real rigs we've built and serviced. Click any photo for the full story.</p>
    <div class="mt-12">
      <BuildGallery client:visible items={items} />
    </div>
    <div class="mt-16">
      <h2 class="text-3xl mb-6">Other recent jobs (photos coming)</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <TodoBlock label="Toyota Sienna 3.5-inch lift" />
        <TodoBlock label="Jeep Gladiator diff service" />
        <TodoBlock label="Ford Transit fuel injectors" />
        <TodoBlock label="GMC Sierra oil service" />
      </div>
    </div>
  </SectionLight>
</BaseLayout>
